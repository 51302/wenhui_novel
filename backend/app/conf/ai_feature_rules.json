  "detect": [
    {
      "name": "三连否定排比",
      "regex": "没有[^，。；！？\\n]{1,10}[，,]没有[^，。；！？\\n]{1,10}[，,](?:只有|就是|是)[^，。；！？\\n]{1,30}",
